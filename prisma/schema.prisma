generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Order lifecycle statuses.
/// Only orders whose payment is manually verified by an admin become `paid`.
enum OrderStatus {
  pending_payment
  payment_submitted
  paid
  rejected
}

/// Payment statuses for manual bKash payment workflow.
/// Payments start as `pending`, then an administrator manually verifies or rejects.
enum PaymentStatus {
  pending
  verified
  rejected
}

enum PaymentMethod {
  manual_bkash
}

/// Represents a customer order for a digital product/subscription.
/// Payable amount is always calculated on the server from the trusted product catalog.
model Order {
  id            String      @id @default(cuid())
  /// Customer identifier (authenticated customer ID or generated session customer ID)
  customerId    String      @map("customer_id") @db.VarChar(100)
  /// Secret token issued to the customer on order creation to verify order ownership
  orderToken    String      @map("order_token") @db.VarChar(100)
  customerEmail String      @map("customer_email") @db.VarChar(255)
  customerPhone String      @map("customer_phone") @db.VarChar(30)
  customerNote  String?     @map("customer_note")
  productId     String      @map("product_id") @db.VarChar(100)
  productName   String      @map("product_name") @db.VarChar(255)
  planName      String      @map("plan_name") @db.VarChar(255)
  /// Authoritative payable amount in BDT calculated server-side
  amount        Decimal     @db.Decimal(12, 2)
  currency      String      @default("BDT") @db.VarChar(3)
  status        OrderStatus @default(pending_payment)
  paidAt        DateTime?   @map("paid_at")

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  payments      Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Represents a manual bKash payment submission.
/// The customer sends money via bKash and submits the transaction ID.
/// An authorized administrator must manually verify the payment by
/// checking the merchant bKash account before changing status.
model Payment {
  id              String        @id @default(cuid())
  orderId         String?       @map("order_id")
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId      String?       @map("customer_id") @db.VarChar(100)
  /// Amount in BDT (Bangladeshi Taka). Always determined server-side, never trusted from the client.
  amount          Decimal       @db.Decimal(12, 2)
  /// Currency code — always BDT for bKash payments.
  currency        String        @default("BDT") @db.VarChar(3)
  /// bKash transaction ID (TrxID) submitted by the customer.
  /// Normalized to uppercase alphanumeric, unique to prevent duplicate submissions.
  transactionId   String        @unique @map("transaction_id") @db.VarChar(20)
  method          PaymentMethod @default(manual_bkash)
  status          PaymentStatus @default(pending)
  /// Optional notes from admin during verification or rejection.
  adminNote       String?       @map("admin_note")
  /// Optional reason provided by admin when rejecting a payment.
  rejectionReason String?       @map("rejection_reason")
  /// Identifier of the admin who verified or rejected the payment.
  verifiedBy      String?       @map("verified_by") @db.VarChar(100)
  /// Timestamp when an admin verified or rejected the payment.
  verifiedAt      DateTime?     @map("verified_at")
  /// Phone number the customer paid from (optional, for reference).
  payerPhone      String?       @map("payer_phone") @db.VarChar(20)

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}
