# Application
NODE_ENV=development
PORT=5000

# Database — PostgreSQL connection string
# Local:    postgresql://user:password@localhost:5432/micro_shop?schema=public
# Neon:     postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/micro_shop?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/micro_shop?schema=public

# CORS — allowed frontend origin
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Manual bKash Payment Configuration (Server-Side)
BKASH_MERCHANT_NUMBER=01960515811
MERCHANT_NAME="Micro-Shop BD"
MERCHANT_LOGO_URL=/logo.png

# Admin Authentication Key (Must be at least 16 characters; required in production)
ADMIN_API_KEY=replace-with-strong-admin-secret-key-min-16-chars

# Telegram Order Notifications (Server-Side)
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id

